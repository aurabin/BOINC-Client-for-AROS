+++ b/workbench/system/Wanderer/wanderer.c
@@ -18,6 +18,9 @@
 #include <zune/customclasses.h>
 
 #include <dos/notify.h>
+#include <dos/var.h>
+#include <devices/serial.h>
+#include <proto/exec.h>
 
 #include <workbench/handler.h>
 
@@ -2933,6 +2936,31 @@ VOID DoMenuNotify(Object* strip, int id, IPTR trigattrib, void *function, void *
 }
 ///
 
+/* Only the Windows Wizard image enables this menu in its startup sequence. */
+#define MEN_WIZARD_FULLSCREEN 0x575A4653
+static void wizard_toggle_fullscreen(void)
+{
+    static const char command[] = "AROS-WIZARD-FULLSCREEN-1\n";
+    struct MsgPort *port = CreateMsgPort();
+    struct IOExtSer *io;
+    if (!port) return;
+    io = (struct IOExtSer *)CreateIORequest(port, sizeof(*io));
+    if (io)
+    {
+        io->io_SerFlags = SERF_XDISABLED;
+        if (OpenDevice(SERIALNAME, 0, (struct IORequest *)io, 0) == 0)
+        {
+            io->IOSer.io_Command = CMD_WRITE;
+            io->IOSer.io_Data = (APTR)command;
+            io->IOSer.io_Length = sizeof(command) - 1;
+            DoIO((struct IORequest *)io);
+            CloseDevice((struct IORequest *)io);
+        }
+        DeleteIORequest((struct IORequest *)io);
+    }
+    DeleteMsgPort(port);
+}
+
